[submodule "tmux/.tmux"]
	path = tmux/.tmux
	url = https://github.com/gpakosz/.tmux.git
[submodule "zsh/.oh-my-zsh"]
	path = zsh/.oh-my-zsh
        url = https://github.com/ohmyzsh/ohmyzsh
[submodule "zsh/.zsh_custom/themes/powerlevel10k"]
	path = zsh/.zsh_custom/themes/powerlevel10k
	url = https://github.com/romkatv/powerlevel10k.git
[submodule "zsh/.zsh_custom/plugins/zsh-vi-mode"]
	path = zsh/.zsh_custom/plugins/zsh-vi-mode
	url = https://github.com/xDDoubleTea/zsh-vi-mode.git
